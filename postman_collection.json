{
  "info": {
    "_postman_id": "c1f7a4d5-89b2-4d1e-bf23-887e1a3bc892",
    "name": "Ledger Core Banking API",
    "description": "Comprehensive Postman collection for Ledger Core - secure core banking transaction engine modeled on Kenya's RTGS and M-Pesa settlement flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountAId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountBId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "disbursementId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.token);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.token);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Accounts",
      "item": [
        {
          "name": "Create Account A (Savings)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('accountAId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-10001\",\n  \"type\": \"SAVINGS\",\n  \"currency\": \"KES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Create Account B (Wallet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('accountBId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-10002\",\n  \"type\": \"WALLET\",\n  \"currency\": \"KES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Get Account by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountAId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountAId}}"]
            }
          }
        },
        {
          "name": "Get Account Balance",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountAId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountAId}}", "balance"]
            }
          }
        },
        {
          "name": "Get Account Statement",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountAId}}/statement?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountAId}}", "statement"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Internal Transfers & Idempotency",
      "item": [
        {
          "name": "Transfer Funds (Original Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.transactionId) {",
                  "    pm.collectionVariables.set('transactionId', jsonData.transactionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "IDEMP-TRF-0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountAId}}\",\n  \"toAccountId\": \"{{accountBId}}\",\n  \"amount\": 500.0000,\n  \"currency\": \"KES\",\n  \"description\": \"Inter-account settlement\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Transfer Funds (Replay - Cached 200 OK)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "IDEMP-TRF-0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountAId}}\",\n  \"toAccountId\": \"{{accountBId}}\",\n  \"amount\": 500.0000,\n  \"currency\": \"KES\",\n  \"description\": \"Inter-account settlement\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Transfer Funds (Mismatched Payload - 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "IDEMP-TRF-0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountAId}}\",\n  \"toAccountId\": \"{{accountBId}}\",\n  \"amount\": 999.0000,\n  \"currency\": \"KES\",\n  \"description\": \"Tampered amount under same key\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Mobile Money Disbursements (M-Pesa B2C)",
      "item": [
        {
          "name": "Initiate Disbursement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('disbursementId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "IDEMP-DISB-0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountAId}}\",\n  \"phoneNumber\": \"254712345678\",\n  \"amount\": 200.0000,\n  \"remarks\": \"Salary payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/disbursements",
              "host": ["{{baseUrl}}"],
              "path": ["disbursements"]
            }
          }
        },
        {
          "name": "Reverse Disbursement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Incorrect beneficiary phone number\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/disbursements/{{disbursementId}}/reverse",
              "host": ["{{baseUrl}}"],
              "path": ["disbursements", "{{disbursementId}}", "reverse"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Webhooks",
      "item": [
        {
          "name": "M-Pesa B2C Result Callback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"AG_20261016_0001\",\n  \"originatorConversationId\": \"ORIG_9999\",\n  \"resultCode\": 0,\n  \"resultDesc\": \"The service request is processed successfully.\",\n  \"transactionId\": \"NLJ7RT61SV\",\n  \"transactionReceipt\": \"NLJ7RT61SV\",\n  \"transactionAmount\": 200.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/mpesa/result",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "mpesa", "result"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Transactions",
      "item": [
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Audit Logs",
      "item": [
        {
          "name": "Query Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit-logs?entityType=ACCOUNT&from=2026-01-01T00:00:00Z",
              "host": ["{{baseUrl}}"],
              "path": ["audit-logs"],
              "query": [
                { "key": "entityType", "value": "ACCOUNT" },
                { "key": "from", "value": "2026-01-01T00:00:00Z" }
              ]
            }
          }
        }
      ]
    }
  ]
}
